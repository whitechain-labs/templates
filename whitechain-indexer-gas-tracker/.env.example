# Copy to `.env` (git-ignored) to point the app at a different Blockscout chain.
# Vite exposes VITE_* to the browser bundle. This SPA has no server, so never put
# a secret here – the Blockscout API is public and needs no key.

# Base URL of the Blockscout explorer to index. Defaults to Whitechain Sepolia.
VITE_EXPLORER_BASE_URL=https://explorer.testnet.whitechain.io
