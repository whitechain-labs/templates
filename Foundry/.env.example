# Whitechain Sepolia (chain 1874) RPC endpoint, referenced by foundry.toml as
# the `whitechain_sepolia` alias. forge loads this file automatically.
WHITECHAIN_SEPOLIA_RPC_URL=https://rpc.testnet.whitechain.io

# Throwaway deployer key, 32 bytes hex, with the 0x prefix.
# Required only to deploy or verify: `forge build` and `forge test` run without it.
# Fund it from https://faucet.testnet.whitechain.io
# Never commit a real key, and never reuse a mainnet key here.
PRIVATE_KEY=
