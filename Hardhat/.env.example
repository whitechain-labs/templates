# Whitechain Sepolia (chain 1874) RPC endpoint. Optional: hardhat.config.ts
# falls back to this same public endpoint when the variable is unset.
TESTNET_RPC_URL=https://rpc.testnet.whitechain.io

# Throwaway deployer key, 32 bytes hex, with or without the 0x prefix.
# Required only to deploy or verify: `compile` and `test` run without it.
# Fund it from https://faucet.testnet.whitechain.io
# Never commit a real key, and never reuse a mainnet key here.
PRIVATE_KEY=
