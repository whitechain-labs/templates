# Copy to `.env` (git-ignored) and fill in. Vite exposes VITE_* to the browser
# bundle at build time. This SPA has no server, so never put a secret here.
#
# Both variables are optional. `pnpm dev` runs with this file left exactly as it
# is: no signup, no keys.

# Reown (WalletConnect) project id, from https://dashboard.reown.com.
# Only WalletConnect needs it. Blank means injected wallets only (MetaMask and
# similar), which still connect, read, and write. Set it to add mobile wallets
# and QR pairing through the Reown AppKit modal.
VITE_REOWN_PROJECT_ID=

# Deployed Storage contract address on Whitechain Sepolia (chain 1874).
# Deploy it with the companion Hardhat or Foundry template, then paste it here.
# Leave blank to use the public verified default in `src/lib/storage.ts`.
VITE_STORAGE_ADDRESS=
