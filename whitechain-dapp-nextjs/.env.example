# Copy to `.env` (git-ignored) and fill in. Both are NEXT_PUBLIC_* — public,
# build-time values baked into the browser bundle. Never put a server secret here.

# Reown (WalletConnect) project id — create one at https://dashboard.reown.com.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Deployed Storage contract address on Whitechain Sepolia (chain 1874).
# Deploy it with the companion Hardhat or Foundry template, then paste it here.
# Leave blank to use the public verified default in `src/lib/storage.ts`.
NEXT_PUBLIC_STORAGE_ADDRESS=
